{
  "$schema" : "https://schema.tauri.app/config/2",
  "productName" : "Inference Chat Studio",
  "version" : "0.3.0",
  "identifier" : "com.alamaby.inference-chat-studio",
  "build" : {
    "frontendDist" : "../apps/desktop/dist",
    "devUrl" : "http://localhost:1420",
    "beforeDevCommand" : "pnpm --filter inference-chat-studio-desktop dev",
    "beforeBuildCommand" : "pnpm --filter inference-chat-studio-desktop build"
  },
  "app" : {
    "withGlobalTauri" : false,
    "windows" : [
      {
        "label" : "main",
        "title" : "Inference Chat Studio",
        "width" : 1280,
        "height" : 800,
        "minWidth" : 960,
        "minHeight" : 600
      },
      {
        "label" : "inspector",
        "title" : "Inspector",
        "url" : "/index.html#/inspector",
        "width" : 600,
        "height" : 800,
        "visible" : false
      }
    ],
    "security" : {
      "csp" : null
    }
  },
  "plugins" : {
    "updater" : {
      "active" : false,
      "endpoints" : ["https://github.com/alamaby/inference-chat-studio/releases/latest/download/latest.json"]
    }
  },
  "bundle" : {
    "active" : true,
    "publisher" : "Alam Aby Bashit",
    "targets" : ["nsis"],
    "icon" : ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows" : {
      "nsis" : {
        "installMode" : "currentUser",
        "languages" : ["English"]
      },
      "webviewInstallMode" : {
        "type" : "embedBootstrapper"
      }
    }
  }
}
